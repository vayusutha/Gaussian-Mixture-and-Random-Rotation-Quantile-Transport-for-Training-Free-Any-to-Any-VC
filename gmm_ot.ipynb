    for root in CANDIDATE_SPLIT_ROOTS:
        if root.exists() and any(root.rglob('*.flac')):
            return root
        if root.exists() and any(root.rglob('*.wav')):
            return root

    matches = []
    for candidate in DRIVE_ROOT.rglob(EVAL_SPLIT):
        if candidate.is_dir() and (any(candidate.glob('*/*/*.flac')) or any(candidate.glob('*/*/*.wav'))):
            matches.append(candidate)
    if matches:
        matches = sorted(matches)
        print('Auto-detected candidates:')
        for m in matches[:10]:
            print(' ', m)
        return matches[0]

    raise FileNotFoundError(
        'Could not locate the LibriSpeech audio split in Drive. Set CUSTOM_SPLIT_ROOT explicitly.'
    )

