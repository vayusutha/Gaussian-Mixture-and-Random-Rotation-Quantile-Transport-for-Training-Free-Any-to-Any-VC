        refs = json.loads(row['reference_wavs'])
        ref_key = tuple(refs)
        if ref_key not in ref_cache:
            ref_embs = [xvector_embedding(p) for p in refs]
            ref_cache[ref_key] = torch.stack(ref_embs).mean(dim=0)

        out_emb = xvector_embedding(str(output_path))
        sim_rows.append({
            'output_wav': str(output_path),
            'target_speaker': row['target_speaker'],
            'reference_wavs': row['reference_wavs'],
            'sim': cosine_sim(out_emb, ref_cache[ref_key]),
        })

