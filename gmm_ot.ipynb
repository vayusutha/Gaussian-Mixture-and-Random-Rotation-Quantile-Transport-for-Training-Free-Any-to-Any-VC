    else:
        pesq_stoi_rows = []
        completed_pesq_stoi = set()

    def load_metric_audio_16k(path):
        wav, sr = torchaudio.load(path)
        wav = wav.mean(dim=0, keepdim=True)
        if sr != 16000:
            wav = torchaudio.functional.resample(wav, sr, 16000)
        return wav.squeeze(0).detach().cpu().numpy().astype(np.float32)

    pending_rows = [r for r in eval_pairs.to_dict('records') if str(r['output_wav']) not in completed_pesq_stoi]
    for row in tqdm(pending_rows, desc='PESQ/STOI'):
        output_path = Path(row['output_wav'])
        if not output_path.exists():
            print('missing output:', output_path)
            continue

        pesq_value = np.nan
        stoi_value = np.nan
        pesq_stoi_error = ''
        try:
            ref_audio = load_metric_audio_16k(row['source_wav'])
            deg_audio = load_metric_audio_16k(str(output_path))
            n = min(len(ref_audio), len(deg_audio))
            ref_audio = ref_audio[:n]
            deg_audio = deg_audio[:n]
            if n < 16000 // 4:
                raise ValueError(f'audio too short after alignment: {n} samples')
            pesq_value = float(pesq(16000, ref_audio, deg_audio, 'wb'))
            stoi_value = float(stoi(ref_audio, deg_audio, 16000, extended=False))
        except Exception as exc:
            pesq_stoi_error = repr(exc)

        pesq_stoi_rows.append({
            'output_wav': str(output_path),
            'source_wav': row['source_wav'],
            'pesq_wb': pesq_value,
            'stoi': stoi_value,
