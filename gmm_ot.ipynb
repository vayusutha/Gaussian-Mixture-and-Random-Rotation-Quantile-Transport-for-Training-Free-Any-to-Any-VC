def parse_speakers_txt(split_root: Path):
    candidates = [
        split_root.parent / 'SPEAKERS.TXT',
        split_root.parent.parent / 'SPEAKERS.TXT',
        split_root / 'SPEAKERS.TXT',
    ]
    speaker_meta = {}
    for path in candidates:
        if not path.exists():
            continue
        for line in path.read_text(errors='ignore').splitlines():
            line = line.strip()
            if not line or line.startswith(';') or '|' not in line:
                continue
            parts = [p.strip() for p in line.split('|')]
            if len(parts) < 5 or not parts[0].isdigit():
                continue
            speaker_meta[parts[0]] = {
                'sex': parts[1],
                'subset': parts[2],
                'minutes': parts[3],
                'name': parts[4],
            }
        if speaker_meta:
            print('Loaded speaker metadata from:', path)
            return speaker_meta
    print('No SPEAKERS.TXT found near split root.')
    return speaker_meta

