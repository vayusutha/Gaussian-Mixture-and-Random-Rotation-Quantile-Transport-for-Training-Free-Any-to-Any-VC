"""## 4. 1D GMM-OT Converter"""

def affine_1d_transport(source_col, target_col, eps=GMM_REG_COVAR):
    """Single-Gaussian 1D transport: match mean and standard deviation."""
    mu_s = source_col.mean()
    mu_t = target_col.mean()
    std_s = source_col.std(unbiased=True).clamp_min(eps ** 0.5)
    std_t = target_col.std(unbiased=True).clamp_min(eps ** 0.5)
    scale = (std_t / std_s).clamp(1.0 / GMM_CLIP_SCALE, GMM_CLIP_SCALE)
    return (source_col - mu_s) * scale + mu_t


def affine_1d_transport_matrix(source_mat, target_mat, eps=GMM_REG_COVAR):
    """Vectorized independent 1D affine transport for many dimensions at once."""
    mu_s = source_mat.mean(dim=0, keepdim=True)
    mu_t = target_mat.mean(dim=0, keepdim=True)
    std_s = source_mat.std(dim=0, unbiased=True, keepdim=True).clamp_min(eps ** 0.5)
    std_t = target_mat.std(dim=0, unbiased=True, keepdim=True).clamp_min(eps ** 0.5)
    scale = (std_t / std_s).clamp(1.0 / GMM_CLIP_SCALE, GMM_CLIP_SCALE)
    return (source_mat - mu_s) * scale + mu_t


def load_precomputed_top_variance_dims():
    """Return a stable top-variance dimension list if configured, otherwise None."""
    if PRECOMPUTED_TOP_VARIANCE_DIMS is not None:
        dims = [int(d) for d in PRECOMPUTED_TOP_VARIANCE_DIMS]
        if len(dims) == 0:
            return None
        return dims

    if PRECOMPUTED_TOP_VARIANCE_DIMS_CSV is not None:
        path = Path(PRECOMPUTED_TOP_VARIANCE_DIMS_CSV)
        if not path.exists():
            raise FileNotFoundError(f'PRECOMPUTED_TOP_VARIANCE_DIMS_CSV not found: {path}')
        dim_df = pd.read_csv(path)
        if 'variance_rank' in dim_df.columns:
            dim_df = dim_df.sort_values('variance_rank')
        elif 'target_variance' in dim_df.columns:
            dim_df = dim_df.sort_values('target_variance', ascending=False)
        elif 'variance' in dim_df.columns:
            dim_df = dim_df.sort_values('variance', ascending=False)
        if 'dim' not in dim_df.columns:
            raise ValueError(f'CSV must contain a dim column: {path}')
        return dim_df['dim'].head(GMM_TOP_VARIANCE_DIMS).astype(int).tolist()

    return None


def fit_1d_gmm_np(values, n_components):
    values = np.asarray(values, dtype=np.float64).reshape(-1, 1)
    if n_components <= 1:
        return None
    gm = GaussianMixture(
        n_components=n_components,
        covariance_type='diag',
        reg_covar=GMM_REG_COVAR,
        max_iter=GMM_MAX_ITER,
        n_init=GMM_N_INIT,
        random_state=GMM_RANDOM_STATE,
    )
    gm.fit(values)

    order = np.argsort(gm.means_.reshape(-1))
    means = gm.means_.reshape(-1)[order]
    variances = gm.covariances_.reshape(-1)[order]
    weights = gm.weights_.reshape(-1)[order]

    # Keep the sklearn object, but expose sorted params. For posterior calls we manually reorder columns.
    return {
        'model': gm,
        'order': order,
        'means': means,
        'stds': np.sqrt(np.maximum(variances, GMM_REG_COVAR)),
        'weights': weights,
    }


def gmm_is_reliable(gmm_info):
    if gmm_info is None:
        return False
    means = gmm_info['means']
    stds = gmm_info['stds']
    weights = gmm_info['weights']
    if np.any(weights < GMM_MIN_COMPONENT_WEIGHT):
        return False
    if len(means) >= 2:
        sep = np.diff(means) / np.maximum(0.5 * (stds[:-1] + stds[1:]), 1e-6)
        if np.min(sep) < GMM_MIN_SEPARATION_STD:
            return False
    return True


def sorted_posteriors(gmm_info, values):
    values = np.asarray(values, dtype=np.float64).reshape(-1, 1)
    post = gmm_info['model'].predict_proba(values)
    return post[:, gmm_info['order']]



def select_gmm_components_by_target_bic(target_values, max_components=GMM_BIC_MAX_COMPONENTS):
    """Choose K from the target dimension only, then fit source with the same K for component matching."""
    values = np.asarray(target_values, dtype=np.float64).reshape(-1, 1)
    max_k = min(int(max_components), max(1, values.shape[0] // 20))
    if max_k <= 1:
        return 1

    best_k = 1
    best_bic = np.inf
    for k in range(1, max_k + 1):
        try:
            gm = GaussianMixture(
                n_components=k,
                covariance_type='diag',
                reg_covar=GMM_REG_COVAR,
                max_iter=GMM_MAX_ITER,
                n_init=GMM_N_INIT,
                random_state=GMM_RANDOM_STATE,
            )
            gm.fit(values)
            bic = gm.bic(values)
        except Exception:
            continue
        if bic < best_bic:
            best_bic = bic
            best_k = k
    return int(best_k)


def gmm_ot_1d_transport(source_col, target_col, n_components=GMM_COMPONENTS):
    """Component-wise 1D Gaussian-mixture transport source -> target.

    Components are sorted by mean and matched in that order.
    Fallback: if either mixture is unreliable/overlapping, use simple 1D affine transport.
    """
    device = source_col.device
    dtype = source_col.dtype
    src_np = source_col.detach().float().cpu().numpy()
    tgt_np = target_col.detach().float().cpu().numpy()

    if GMM_COMPONENT_MODE == 'target_bic':
        n_components = select_gmm_components_by_target_bic(tgt_np, max_components=GMM_BIC_MAX_COMPONENTS)
    elif GMM_COMPONENT_MODE != 'fixed':
        raise ValueError(f'Unknown GMM_COMPONENT_MODE: {GMM_COMPONENT_MODE}')

    if n_components <= 1 or source_col.numel() < max(20, 10 * n_components) or target_col.numel() < max(20, 10 * n_components):
        return affine_1d_transport(source_col, target_col), 'affine_k1_or_low_sample'

    try:
        src_gmm = fit_1d_gmm_np(src_np, n_components)
        tgt_gmm = fit_1d_gmm_np(tgt_np, n_components)
    except Exception:
        return affine_1d_transport(source_col, target_col), 'affine_gmm_fit_failed'

    if not (gmm_is_reliable(src_gmm) and gmm_is_reliable(tgt_gmm)):
        return affine_1d_transport(source_col, target_col), 'affine_unreliable_gmm'

    src_means = torch.tensor(src_gmm['means'], device=device, dtype=dtype)
    src_stds = torch.tensor(src_gmm['stds'], device=device, dtype=dtype).clamp_min(GMM_REG_COVAR ** 0.5)
    tgt_means = torch.tensor(tgt_gmm['means'], device=device, dtype=dtype)
    tgt_stds = torch.tensor(tgt_gmm['stds'], device=device, dtype=dtype).clamp_min(GMM_REG_COVAR ** 0.5)
    scales = (tgt_stds / src_stds).clamp(1.0 / GMM_CLIP_SCALE, GMM_CLIP_SCALE)

    # T x C candidate maps.
    mapped_by_component = (source_col[:, None] - src_means[None, :]) * scales[None, :] + tgt_means[None, :]

    src_post = torch.tensor(sorted_posteriors(src_gmm, src_np), device=device, dtype=dtype)
    if GMM_ASSIGNMENT_MODE == 'hard':
        comp = src_post.argmax(dim=1)
        out = mapped_by_component[torch.arange(source_col.shape[0], device=device), comp]
    elif GMM_ASSIGNMENT_MODE == 'posterior_soft':
        out = (src_post * mapped_by_component).sum(dim=1)
    else:
        raise ValueError(f'Unknown GMM_ASSIGNMENT_MODE: {GMM_ASSIGNMENT_MODE}')

    return out, 'gmm_ot'


@torch.inference_mode()
def gmm_ot_transport_features(source_feats, target_feats):
    """Low dims: 1D affine MKL. Top target-variance dims: 1D GMM-OT."""
    x = source_feats.float()
    y = target_feats.float().to(x.device)
    if x.ndim != 2 or y.ndim != 2:
        raise ValueError('source_feats and target_feats must both have shape [T, D]')
    if x.shape[1] != y.shape[1]:
        raise ValueError(f'dimension mismatch: {x.shape} vs {y.shape}')

    out = torch.empty_like(x)
    dim = x.shape[1]

    precomputed_dims = load_precomputed_top_variance_dims()
    top_count = min(GMM_TOP_VARIANCE_DIMS, dim)
    if precomputed_dims is not None:
        top_dims_list = [d for d in precomputed_dims[:top_count] if 0 <= int(d) < dim]
        top_dim_source = 'precomputed'
    else:
        if GMM_VARIANCE_SOURCE == 'target':
            variances = y.var(dim=0, unbiased=True)
        elif GMM_VARIANCE_SOURCE == 'source':
            variances = x.var(dim=0, unbiased=True)
        else:
            variances = torch.cat([x, y], dim=0).var(dim=0, unbiased=True)
        top_dims_list = torch.argsort(variances, descending=True)[:top_count].detach().cpu().tolist()
        top_dim_source = f'pair_{GMM_VARIANCE_SOURCE}'

    top_dims = set(int(d) for d in top_dims_list)
    low_dims = [d for d in range(dim) if d not in top_dims]

    status_counts = {'top_dim_source_' + top_dim_source: 1}

    # Vectorized affine map for the many low-variance dimensions.
    if low_dims:
        low_idx = torch.tensor(low_dims, device=x.device, dtype=torch.long)
        out[:, low_idx] = affine_1d_transport_matrix(x[:, low_idx], y[:, low_idx])
        status_counts['affine_low_variance_dim'] = len(low_dims)

    # GMM-OT is still per dimension, because each selected dimension has its own mixture fit.
    for d in top_dims_list:
        d = int(d)
        out[:, d], status = gmm_ot_1d_transport(x[:, d], y[:, d], n_components=GMM_COMPONENTS)
        status_counts[status] = status_counts.get(status, 0) + 1

    return out, status_counts


@torch.inference_mode()
def vocode_features(knn_vc, out_feats, tgt_loudness_db=TGT_LOUDNESS_DB, device=None):
    run_device = torch.device(device) if device is not None else knn_vc.device
    prediction = knn_vc.vocode(out_feats[None].to(run_device)).cpu().squeeze()
    if tgt_loudness_db is not None:
        src_loudness = torchaudio.functional.loudness(prediction[None], knn_vc.h.sampling_rate)
        prediction = torchaudio.functional.gain(prediction, tgt_loudness_db - src_loudness)
    return prediction


@torch.inference_mode()
def transport_match_vocode(knn_vc, query_seq, matching_set, tgt_loudness_db=TGT_LOUDNESS_DB, device=None):
    run_device = torch.device(device) if device is not None else knn_vc.device
    query_seq = query_seq.to(run_device)
    matching_set = matching_set.to(run_device)
    out_feats, status_counts = gmm_ot_transport_features(query_seq, matching_set)
    wav = vocode_features(knn_vc, out_feats, tgt_loudness_db=tgt_loudness_db, device=run_device)
    return wav, out_feats, status_counts

