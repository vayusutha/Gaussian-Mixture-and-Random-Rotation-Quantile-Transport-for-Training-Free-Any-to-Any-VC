"""## 7. WER/CER/SIM Evaluation

The MKL-VC paper reports WER and CER from Whisper-base against the source transcript, and SIM as cosine similarity between X-vector embeddings of converted audio and target reference audio. This section saves both per-pair metrics and a Table-2-style aggregate row.

"""

def normalize_text_for_error_rate(text):
    text = text.lower()
    text = re.sub(r"[^a-z0-9' ]+", ' ', text)
    text = re.sub(r'\s+', ' ', text).strip()
    return text

_transcript_cache = {}
def transcript_path_for_librispeech_audio(audio_path):
    audio_path = Path(audio_path)

    # Canonical LibriSpeech layout: split/speaker/chapter/speaker-chapter-utt.flac
    # Transcript file: split/speaker/chapter/speaker-chapter.trans.txt
    parts = audio_path.stem.split('-')
    candidates = []
    if len(parts) >= 2:
        candidates.append(audio_path.parent / f'{parts[0]}-{parts[1]}.trans.txt')

    # Fallbacks for copied/custom layouts.
    candidates.append(audio_path.parent / f'{audio_path.parent.name}.trans.txt')
    candidates.extend(sorted(audio_path.parent.glob('*.trans.txt')))

    for candidate in candidates:
        if candidate.exists():
            return candidate

    raise FileNotFoundError(
        f'No LibriSpeech transcript file found for {audio_path}. '
        f'Expected something like {audio_path.parent / ("-".join(parts[:2]) + ".trans.txt") if len(parts) >= 2 else audio_path.parent / "*.trans.txt"}'
    )

def librispeech_transcript(audio_path):
    audio_path = Path(audio_path)
    trans_path = transcript_path_for_librispeech_audio(audio_path)
    if trans_path not in _transcript_cache:
        rows = {}
        for line in trans_path.read_text(errors='ignore').splitlines():
            if not line.strip():
                continue
            utt_id, text = line.split(' ', 1)
            rows[utt_id] = text.strip()
        _transcript_cache[trans_path] = rows

    if audio_path.stem not in _transcript_cache[trans_path]:
        raise KeyError(f'{audio_path.stem} not found in transcript file {trans_path}')
    return _transcript_cache[trans_path][audio_path.stem]

def cosine_sim(a, b):
    a = F.normalize(a.flatten().float(), dim=0)
    b = F.normalize(b.flatten().float(), dim=0)
    return float(torch.dot(a, b).cpu())

def table2_total_score(wer, cer, sim):
    return float(np.sqrt(wer ** 2 + cer ** 2 + (1.0 - sim) ** 2))

