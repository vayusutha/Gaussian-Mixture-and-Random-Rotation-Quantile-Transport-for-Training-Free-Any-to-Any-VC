    from speechbrain.inference.speaker import EncoderClassifier

    spk_model = EncoderClassifier.from_hparams(
        source=XVECTOR_MODEL_NAME,
        run_opts={'device': device},
    )

    @torch.inference_mode()
    def xvector_embedding(path):
        wav, sr = torchaudio.load(path)
        wav = wav.mean(dim=0, keepdim=True)
        if sr != 16000:
            wav = torchaudio.functional.resample(wav, sr, 16000)
        wav = wav.to(device)
        emb = spk_model.encode_batch(wav)
        return emb.squeeze().detach().cpu()

    sim_rows = []
    ref_cache = {}
    for row in tqdm(eval_pairs.to_dict('records'), desc='X-vector SIM'):
        output_path = Path(row['output_wav'])
