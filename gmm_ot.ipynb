    if GENDER_FILTER is not None:
        speakers = [spk for spk in speakers if speaker_meta.get(spk, {}).get('sex') == GENDER_FILTER]

    return sorted(speakers)

def choose_balanced_speakers(pool, n):
    females = [s for s in pool if speaker_meta.get(s, {}).get('sex') == 'F']
    males = [s for s in pool if speaker_meta.get(s, {}).get('sex') == 'M']
    random.shuffle(females)
    random.shuffle(males)
    chosen = []
    while len(chosen) < n and (females or males):
        if females and len(chosen) < n:
            chosen.append(females.pop())
        if males and len(chosen) < n:
            chosen.append(males.pop())
    return chosen[:n]

